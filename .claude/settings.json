{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run review:*)",
      "Bash(npm run apply:*)",
      "Bash(npm run audit:*)",
      "Bash(node scripts/*)",
      "Bash(node rooms-server/*.test.mjs)",
      "Bash(node rooms-server/admin-hash.mjs:*)",
      "Bash(npx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(scp:*)",
      "Bash(ssh:*)"
    ]
  }
}
